# Supabase — Zugriff ausschließlich serverseitig, siehe ADR-03 im Architekturkonzept.
# Die URL ist unkritisch (öffentlich), der Service-Role-Key ist ein Geheimnis und
# darf NIE mit NEXT_PUBLIC_-Präfix versehen oder committet werden.
NEXT_PUBLIC_SUPABASE_URL=https://kuksetznpnsfxjhubdvg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — für Benachrichtigungen (z. B. Rest-Timer). Erzeugen mit:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:godinezjoel872@gmail.com

# Zugriffsschutz — Supabase Auth mit registrierten Benutzern.
